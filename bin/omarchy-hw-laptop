#!/bin/bash

# omarchy:summary=Returns true when running on a laptop (has a lid or laptop chassis).

# A lid switch is the definitive signal for clamshell-capable hardware.
for state in /proc/acpi/button/lid/*/state; do
  [[ -e $state ]] && exit 0
done

# Machines without ACPI report the same lid through an input device instead:
# SW_LID is bit 0 of a device's switch bitmap, which the last field of its
# "B: SW=" line carries. This is how an ARM laptop says it has a lid.
input_devices="${OMARCHY_INPUT_DEVICES_PATH:-/proc/bus/input/devices}"
if [[ -r $input_devices ]]; then
  while read -r line; do
    [[ $line == "B: SW="* ]] || continue

    switches=${line#"B: SW="}
    switches=${switches##* }
    [[ $switches =~ ^[0-9a-fA-F]+$ ]] || continue
    (( 0x$switches & 1 )) && exit 0
  done <"$input_devices"
fi

# Fall back to the DMI chassis type for laptops that don't expose an ACPI lid
# button. 8=Portable 9=Laptop 10=Notebook 14=Sub Notebook 30=Tablet
# 31=Convertible 32=Detachable. Machines without a firmware DMI table have no
# such file, and reading it anyway just writes noise to every caller's stderr.
chassis_type=""
[[ -r /sys/class/dmi/id/chassis_type ]] && chassis_type=$(</sys/class/dmi/id/chassis_type)

case $chassis_type in
8 | 9 | 10 | 14 | 30 | 31 | 32) exit 0 ;;
esac

exit 1
