#!/bin/bash

# omarchy:summary=Regenerate the extlinux config that U-Boot reads on ARM boards.
# omarchy:requires-sudo=true

# The ARM counterpart of omarchy-refresh-limine. U-Boot's sysboot reads
# /boot/extlinux/extlinux.conf and boots the kernel, initramfs and device tree
# it names as ordinary files off the root filesystem, so a kernel upgrade only
# has to leave this file describing what is currently in /boot.
#
# Two entries are written, newest configuration first: if the default entry
# fails to load, U-Boot walks the remaining labels on its own
# (boot_unattempted_labels() in boot/pxe_utils.c). That is the only recovery
# path on a machine like the C201P, which has no serial console and no display
# during U-Boot, so a boot menu would be invisible but the fallthrough still
# works.

set -euo pipefail

BOOT_DIR="${OMARCHY_BOOT_DIR:-/boot}"
SETTINGS_FILE="${OMARCHY_EXTLINUX_SETTINGS:-/etc/omarchy/extlinux.conf}"

# Board settings are written once by install/armv7/extlinux.sh, so this command
# never has to guess what a rerun on a live machine cannot rediscover.
if [[ -f $SETTINGS_FILE ]]; then
  source "$SETTINGS_FILE"
fi

dtb="${OMARCHY_EXTLINUX_DTB:-}"
root_spec="${OMARCHY_EXTLINUX_ROOT:-}"
cmdline="${OMARCHY_EXTLINUX_CMDLINE:-rw rootwait panic=10 console=tty0}"

conf="$BOOT_DIR/extlinux/extlinux.conf"

kernel=""
for candidate in zImage Image vmlinuz-linux; do
  if [[ -f $BOOT_DIR/$candidate ]]; then
    kernel="$candidate"
    break
  fi
done

if [[ -z $kernel ]]; then
  echo "Error: no kernel image found in $BOOT_DIR" >&2
  exit 1
fi

# Derive the board's device tree from what the board calls itself, so the whole
# veyron family works and not just the C201P: "rockchip,rk3288" + "google,speedy"
# name dtbs/rockchip/rk3288-veyron-speedy.dtb.
find_dtb() {
  local compatible="${OMARCHY_DT_COMPATIBLE_PATH:-/proc/device-tree/compatible}"
  local entry soc board candidate

  [[ -r $compatible ]] || return 1

  # "rockchip,rk3288" gives the filename prefix upstream builds dtbs under; the
  # board entries give the rest.
  soc=$(tr '\0' '\n' <"$compatible" | sed -nE 's|^[a-z0-9]+,(rk[0-9]+)$|\1|p' | head -n 1)
  [[ -n $soc ]] || return 1

  # Walk the compatible list as it stands: most specific board revision first,
  # down to the family. "google,veyron-speedy-rev9" has no dtb of its own, so
  # the walk falls through to "google,veyron-speedy", which does. Search rather
  # than assume a vendor subdirectory, since layouts differ between kernels.
  while read -r entry; do
    board="${entry#*,}"
    candidate=$(find "$BOOT_DIR/dtbs" -name "${soc}-${board}.dtb" -printf '%P\n' 2>/dev/null | sort | head -n 1)
    if [[ -n $candidate ]]; then
      printf '%s\n' "dtbs/$candidate"
      return 0
    fi
  done < <(tr '\0' '\n' <"$compatible")

  return 1
}

if [[ -z $dtb ]]; then
  dtb=$(find_dtb || true)
fi

if [[ -z $dtb ]]; then
  echo "Error: no device tree found for this board. Set OMARCHY_EXTLINUX_DTB in $SETTINGS_FILE" >&2
  exit 1
fi

if [[ ! -f $BOOT_DIR/$dtb ]]; then
  echo "Error: device tree $BOOT_DIR/$dtb is missing" >&2
  exit 1
fi

# PARTUUID survives the SD card landing on a different mmcblk number than it had
# when the image was built, which a bare /dev/mmcblk1p2 would not.
if [[ -z $root_spec ]]; then
  root_source=$(findmnt -no SOURCE / 2>/dev/null || true)
  root_partuuid=""
  [[ -n $root_source ]] && root_partuuid=$(lsblk -no PARTUUID "$root_source" 2>/dev/null | head -n 1 || true)

  if [[ -n $root_partuuid ]]; then
    root_spec="PARTUUID=$root_partuuid"
  elif [[ -n $root_source ]]; then
    root_spec="$root_source"
  else
    echo "Error: could not determine the root filesystem. Set OMARCHY_EXTLINUX_ROOT in $SETTINGS_FILE" >&2
    exit 1
  fi
fi

emit_label() {
  local label="$1" menu="$2" initramfs="$3"

  echo
  echo "LABEL $label"
  echo "  MENU LABEL $menu"
  echo "  KERNEL /boot/$kernel"
  [[ -n $initramfs ]] && echo "  INITRD /boot/$initramfs"
  echo "  FDT /boot/$dtb"
  echo "  APPEND root=$root_spec $cmdline"
}

initramfs=""
[[ -f $BOOT_DIR/initramfs-linux.img ]] && initramfs="initramfs-linux.img"

fallback_initramfs=""
[[ -f $BOOT_DIR/initramfs-linux-fallback.img ]] && fallback_initramfs="initramfs-linux-fallback.img"

generated=$(mktemp)
trap 'rm -f "$generated"' EXIT

{
  echo "# Generated by omarchy-refresh-extlinux - do not edit."
  echo "DEFAULT omarchy"
  # Tenths of a second, as in syslinux: three seconds before the default boots.
  echo "TIMEOUT 30"

  emit_label omarchy "Omarchy" "$initramfs"

  # The fallback initramfs carries every module rather than the ones this
  # machine needed last time it booted, so it is the entry that survives a
  # storage or display driver falling out of the trimmed image.
  if [[ -n $fallback_initramfs ]]; then
    emit_label omarchy-fallback "Omarchy (fallback initramfs)" "$fallback_initramfs"
  fi
} >"$generated"

if (( EUID == 0 )) || [[ -w $BOOT_DIR ]]; then
  install -Dm644 "$generated" "$conf"
else
  sudo install -Dm644 "$generated" "$conf"
fi

echo "Wrote $conf (kernel $kernel, dtb $dtb, root $root_spec)"
